# KoraMarket Backend Environment Configuration
# Copy this file to server/.env and fill in real local values.
# NEVER commit server/.env to Git or GitHub.

# Server runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=koramarket
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_POSTGRES_PASSWORD

# JWT Authentication
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_HEX_SECRET
JWT_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
